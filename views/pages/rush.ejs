<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Rush - NYU Pi Delta Psi</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body class="bg-white text-gray-900">

  <!-- Shared Header -->
  <%- include('../partials/header') %>

  <!-- Main content -->
  <main>
    <!-- Banner Section -->
    <section class="relative w-full h-[65vh] md:h-screen overflow-hidden">
      <img src="/images/desktop/jboard.jpg" class="absolute inset-0 w-full h-full object-cover object-center z-0" />
      <div class="absolute inset-0 flex items-center justify-center z-10 px-4 text-center">
        <h1 class="text-white text-4xl md:text-6xl font-bold drop-shadow-lg">
          EARN YOUR LETTERS
        </h1>
      </div>
    </section>
    
    <!-- Fall 2025 -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-6xl mx-auto space-y-10">

        <div class="flex flex-col md:flex-row md:items-center md:justify-start gap-4 md:gap-6 text-center md:text-left">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-black">
            Fall 2025 
          </h2>
          <a href="https://forms.gle/drKCrRSa2YMVctqD7" target="_blank"
            class="inline-block bg-black text-white px-6 py-3 rounded-full font-bold text-sm md:text-base hover:bg-red-600 transition duration-300">
            Rush Interest Form
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
            <img src="/images/rush/fa24_cover.PNG" alt="Fall 2025 Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
            <img src="/images/rush/fa24_date.PNG" alt="Fall 2025 Date" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
        </div>
      </div>
    </section>


    <!-- Rush Gallery -->
    <section class="bg-white py-16 px-6">
      <div class="max-w-6xl mx-auto space-y-16">
        <h2 class="text-4xl font-extrabold text-center">Rush Archive</h2>

        <!-- Spring 2025 -->
        <div class="space-y-6">
          <h3 class="text-2xl md:text-3xl font-bold border-b pb-2 border-gray-300">Spring 2025</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/sp25_cover.PNG" alt="Spring 2025 Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/sp25_date.PNG" alt="Spring 2025 Date" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
          </div>
        </div>

        <!-- Fall 2024 -->
        <div class="space-y-6">
          <h3 class="text-2xl md:text-3xl font-bold border-b pb-2 border-gray-300">Fall 2024</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/fa24_cover.PNG" alt="Fall 2024 Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/fa24_date.PNG" alt="Fall 2024 Date" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
          </div>
        </div>

        <!-- Spring 2024 -->
        <div class="space-y-6">
          <h3 class="text-2xl md:text-3xl font-bold border-b pb-2 border-gray-300">Spring 2024</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/sp24_cover.PNG" alt="Spring 2024 Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/sp24_date.PNG" alt="Spring 2024 Date" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
          </div>
        </div>

        <!-- Fall 2023 -->
        <div class="space-y-6">
          <h3 class="text-2xl md:text-3xl font-bold border-b pb-2 border-gray-300">Fall 2023</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/fa23_cover.PNG" alt="Fall 2023 Cover" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="relative aspect-square overflow-hidden rounded-3xl shadow-xl group">
              <img src="/images/rush/fa23_date.PNG" alt="Fall 2023 Date" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- Shared Footer -->
  <%- include('../partials/footer') %>

</body>
</html>
