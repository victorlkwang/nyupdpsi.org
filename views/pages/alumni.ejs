    <!-- Hero Banner -->
    <section class="relative w-full h-[65vh] md:h-screen overflow-hidden">
      <img src="/images/desktop/beta-etas.PNG" class="absolute inset-0 w-full h-full object-cover object-center z-0"/>
      <div class="absolute inset-0 flex items-center justify-center z-10 px-4 text-center">
        <h1 class="text-white text-4xl md:text-6xl font-bold drop-shadow-lg">
          LEGACY LIVES ON
        </h1>
      </div>
    </section>

    <!-- Filter + Gallery Section -->
    <section class="max-w-6xl mx-auto px-4 py-12">

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        <template x-for="className in Object.keys(alumni)" :key="className">
          <button
            @click="activeClass = className"
            x-text="className"
            :class="activeClass === className ? 'bg-red-600 text-white' : 'bg-gray-200 text-black'"
            class="px-4 py-2 rounded-full font-medium shadow transition-all duration-200"
          ></button>
        </template>
      </div>

      <!-- Empty State -->
      <template x-if="alumni[activeClass].length === 0">
        <div class="text-center text-gray-500">No alumni listed yet.</div>
      </template>

      <!-- Desktop Grid -->
      <div class="hidden md:flex justify-between gap-6" x-show="alumni[activeClass].length > 0">
        <template x-for="i in 4" :key="i">
          <div class="flex flex-col gap-5 w-1/4">
            <template x-for="(person, index) in alumni[activeClass].filter((_, idx) => idx % 4 === i - 1)" :key="person.src + index">
              <div class="relative h-80 rounded-lg overflow-hidden shadow group">
                <img :src="person.src" class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105" />
                <div class="absolute inset-0 bg-black bg-opacity-70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center px-4">
                  <div class="text-white text-center text-sm space-y-1">
                    <p class="text-lg font-semibold" x-text="person.number"></p>
                    <p class="text-lg font-semibold" x-text="person.name"></p>
                    <p x-text="'Big: ' + person.big"></p>
                    <p x-text="'Little: ' + person.little"></p>
                  </div>
                </div>
              </div>
            </template>
          </div>
        </template>
      </div>

      <!-- Mobile List -->
      <div class="flex flex-col gap-4 md:hidden" x-show="alumni[activeClass].length > 0">
        <template x-for="(person, index) in alumni[activeClass]" :key="person.src + index">
          <div 
            class="relative h-80 rounded-lg overflow-hidden shadow group"
            x-data="{ show: false }"
            @click="show = !show"
          >
            <img :src="person.src" class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105" />
            <div 
              class="absolute inset-0 bg-black bg-opacity-70 transition-opacity duration-300 flex items-center justify-center px-4"
              :class="{ 'opacity-100': show, 'opacity-0': !show }"
            >
              <div class="text-white text-center text-sm space-y-1">
                <p class="text-lg font-semibold" x-text="person.number"></p>
                <p class="text-lg font-semibold" x-text="person.name"></p>
                <p x-text="'Big: ' + person.big"></p>
                <p x-text="'Little: ' + person.little"></p>
              </div>
            </div>
          </div>
        </template>
      </div>

    </section>
