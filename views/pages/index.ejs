<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Home - NYU Pi Delta Psi</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="/style.css" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" href="/images/mobile/bg.PNG" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/images/mobile/bg.PNG" />

  <meta property="og:title" content="NYU Pi Delta Psi" />
  <meta property="og:image" content="/images/desktop/cross.PNG" />
  <meta property="og:site_name" content="NYU PDPSI"/>
  <meta name="application-name" content="NYU PDPSI" />
  <meta property="og:url" content="https://nyupdpsi.org" />
  <meta property="og:type" content="website" />
</head>
<body class="bg-gray-100 text-gray-900">

  <!-- Shared Header -->
  <%- include('../partials/header') %>

  <main>
    <!-- Hero Banner -->
    <section class="relative w-full h-full overflow-hidden">
      <!-- Mobile -->
      <img src="/images/mobile/bg.PNG" alt="Mobile Background" class="relative w-full h-full object-cover object-center block md:hidden absolute inset-0 z-0"/>

      <!-- Desktop --> 
      <img src="/images/desktop/bg.png" alt="Desktop Background" class="relative w-full h-full object-cover object-center hidden md:block absolute inset-0 z-0"/>

      <div class="absolute left-1/2 -translate-x-1/2 top-12 md:top-36 z-10 w-[90%] ">
        <h1 class="text-white text-4xl md:text-8xl font-bold text-center px-4"> NYU Pi Delta Psi </h1>
      </div>

      <div class="absolute left-1/2 -translate-x-1/2 bottom-12 md:bottom-36 z-10 w-[90%]">
        <h1 class="text-white text-4xl md:text-8xl font-bold text-center px-4"> Zeta Chapter </h1>
      </div>
    </section>

    <!-- PDPsi -->
    <section class="relative w-full bg-black align-bottom">
      <div class="text-center w-[80%] md:w-[60%] mx-auto ">
        <h2 class="text-2xl md:text-4xl font-bold mb-3 text-white">Pi Delta Psi Fraternity, Incorporated</h2>
        <p class="text-xs md:text-2xl text-gray-400">
          Pi Delta Psi is the fastest growing Asian-American interest fraternity in the United States. 
          Founded in the spring of 1997, the Zeta Chapter of Pi Delta Psi at New York University is home 
          to 20+ active brothers from all backgrounds, joined by one brotherhood.
        </p>
      </div>
    </section>

    <!-- Logo -->
    <section class="w-full bg-black">
      <!-- Mobile -->
      <img src="/images/mobile/pdpsi_logo.PNG" alt="Mobile Logo"
          class="w-full object-contain object-center block md:hidden align-bottom" />

      <!-- Desktop -->
      <img src="/images/desktop/pdpsi_logo.png" alt="Desktop Logo"
          class="w-full object-contain object-center hidden md:block align-bottom" />
    </section>

    <!-- Pillars -->
    <!-- <section class="w-full bg-white text-black py-20 px-4">
      <div class="w-full mx-auto text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold">Our Four Pillars</h2>
      </div>

      <div class="relative md:h-24 flex flex-col md:block items-center gap-4 md:gap-0">
        <button class="pillar-btn w-72 bg-black text-white px-4 py-2 rounded-full font-semibold md:absolute md:left-[20%] md:-translate-x-1/2" data-pillar="academic">
          Academic Achievement 
        </button>

        <button class="pillar-btn w-72 bg-black text-white px-4 py-2 rounded-full font-semibold md:absolute md:left-[40%] md:-translate-x-1/2" data-pillar="cultural">
          Cultural Awaremess
        </button>

        <button class="pillar-btn w-72 bg-black text-white px-4 py-2 rounded-full font-semibold md:absolute md:left-[60%] md:-translate-x-1/2" data-pillar="righteousness">
          Righteousness
        </button>

        <button class="pillar-btn w-72 bg-black text-white px-4 py-2 rounded-full font-semibold md:absolute md:left-[80%] md:-translate-x-1/2" data-pillar="friendship">
          Friendship & Loyalty 
        </button>
      </div>

      <div id="pillarContent" class="mt-10 md:mt-5 text-center text-gray-700 text-base md:text-lg max-w-3xl mx-auto">
        <p>Select a pillar to learn more.</p>
