    <section class="w-full bg-white text-black py-10 px-4">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">

      <!-- Left Column: Image -->
        <div class="w-full md:w-1/2 aspect-square overflow-hidden rounded-lg shadow-md">
          <img src="/images/desktop/prez.jpg" alt="Chapter President" class="w-full rounded-lg shadow-md"/>
        </div>

        <!-- Right Column: Text -->
        <div class="w-full md:w-1/2 md:ml-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">A LETTER FROM OUR CHAPTER PRESIDENT</h2>
          <p class="text-gray-800 mb-4">
            Welcome to the official website of NYU’s Pi Delta Psi Fraternity, Inc., Zeta Chapter. Pi Delta Psi was founded in 1994, and the Zeta Chapter at NYU was established in 1997 based on the pillars of academic achievement, cultural awareness, righteousness, and brotherhood.
          </p>
          <p class="text-gray-800 mb-4">
            Being part of Pi Delta Psi has given me the opportunity to form lifelong bonds with incredible brothers — united through shared values and a commitment to growth. I’m proud to lead this chapter and continue building a community rooted in culture and character.
          </p>
          <p class="text-gray-800 mb-4">
            If you'd like to learn more, feel free to reach out or explore the rest of our site. Our brotherhood welcomes all who share in our vision.
          </p>
          <p class="font-bold italic">
            — Devon Shih, Chapter President
          </p>
        </div>

      </div>
    </section>

    <section class="w-full bg-white text-black py-10 px-6 text-center">
      <h2 class="text-2xl md:text-4xl font-bold mb-6">Interested in Joining?</h2>

      <a href="/rush" class="inline-block bg-red-800 text-white text-lg md:text-2xl font-semibold px-10 py-4 rounded-full hover:bg-gray-200 transition duration-200 shadow-md">
        Rush
      </a>
    </section>
  </main>

  <%- include('../partials/footer') %>

  <script>
    const buttons = document.querySelectorAll('.pillar-btn');
    const content = document.getElementById('pillarContent');

    const pillarText = {
      academic: "We don’t just show up — we show out. At Pi Delta Psi, we hold ourselves and each other accountable to grind hard in the classroom. Whether it’s late-night study sessions or pushing for that GPA boost, we stay locked in and help our brothers level up, every semester.",
      cultural: "We rep where we come from. Pi Delta Psi was built to uplift Asian-American identity, and we take pride in our roots. From hosting culture shows to speaking out on real issues, we keep it authentic, educate with purpose, and always put heritage front and center",
      righteousness: "We do what’s right — no excuses. Being a brother means holding yourself to a higher standard and backing it up with your actions. We look out for our community, hold each other down, and make sure every decision reflects the values we stand on.",
      friendship: "This isn’t just a group — it’s a bond for life. Through every rush, line, and late-night memory, we build something real. Loyalty means always showing up, always riding for your brothers, and knowing we’ve got each other’s backs no matter what."
    };

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-pillar');
        content.innerHTML = `<p>${pillarText[key]}</p>`;
      });
    });
  </script>

</body>
</html>
