# Postgres connection string.
#
# Local development: run `docker compose up -d` (see docker-compose.yml),
# then use the value below as-is.
#
# Production (DigitalOcean App Platform): set DATABASE_URL as an encrypted
# app-level environment variable pointing at your Dev Database / Managed
# Postgres connection string (the one with sslmode=require). Never put the
# real value in this file or commit it anywhere.
DATABASE_URL="postgresql://pdpsi:pdpsi@localhost:5432/pdpsi?schema=public"
