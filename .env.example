# Postgres connection string. Works with DigitalOcean Managed Databases,
# Neon, Supabase, or a local Postgres instance.
#
# For a DigitalOcean Managed Postgres cluster: Databases -> your cluster ->
# Connection Details -> "Connection string" (use the one with sslmode=require).
# Example: postgresql://doadmin:PASSWORD@db-postgresql-nyc1-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/pdpsi?schema=public"
