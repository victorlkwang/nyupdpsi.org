# Postgres connection string.
#
# Local development: run `docker compose up -d` (see docker-compose.yml),
# then use the value below as-is.
#
# Production (DigitalOcean App Platform): set DATABASE_URL to your Managed
# Postgres connection string. If the database is attached as a component, the
# binding ${db.DATABASE_URL} works (use it AS-IS — do not append extra query
# params like &schema=... or ?sslmode=...). TLS is handled in lib/prisma.ts.
# Never put the real value in this file or commit it anywhere.
#
# Optional, recommended for production: DATABASE_CA_CERT holds DigitalOcean's
# CA certificate (download it from the database's Connection Details page). When
# set, the app verifies the server certificate instead of skipping verification.
DATABASE_URL="postgresql://pdpsi:pdpsi@localhost:5432/pdpsi?schema=public"

# --- Authentication & email ---------------------------------------------------

# Emails listed here (comma-separated) automatically become ADMIN when they sign
# up. Set this to your own email BEFORE creating your account to bootstrap the
# first admin. Example: ADMIN_EMAILS="you@nyu.edu,other@nyu.edu"
ADMIN_EMAILS=""

# Base URL used to build links inside verification / password-reset emails.
# Local dev: http://localhost:3000  •  Production: https://nyupdpsi.org
APP_URL="http://localhost:3000"

# Resend API key for sending emails. Create a free account at resend.com, then
# API Keys → Create. Without this, emails are skipped and the link is printed to
# the server log instead (handy for local testing).
RESEND_API_KEY=""

# The "from" address for emails. Must be on a domain you've verified in Resend.
# Until you verify nyupdpsi.org, leave this unset to use Resend's test sender
# (which only delivers to your own Resend account email).
EMAIL_FROM="NYU PDPsi <noreply@nyupdpsi.org>"
