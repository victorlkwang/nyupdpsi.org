generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BRO
  RANDO
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Year {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
}

enum BrotherStatus {
  ACTIVE
  ALUMNI
}

enum School {
  STERN
  STEINHARDT
  CAS
  GALLATIN
  TANDON
  TISCH
  OTHER
}

enum MessageKind {
  THANK_YOU
  GOOD_KID // internal name for the follow-up message sent to selected rushees
}

// The six rush events whose attendance sheets can replace the interest form.
enum RushEvent {
  SCAVENGER_HUNT
  ACTIVITY_NIGHT_KAPPAS
  ACTIVITY_NIGHT_SIGMAS
  GAME_NIGHT
  GENERAL_INTEREST_MEETING
  ACTIVITY_NIGHT_AKDPHIS
}

// Single-row (id = 1) global setting for what the public /rush form shows.
// activeEvent = null means the normal rush interest form; otherwise the
// attendance sheet for that event.
model FormSetting {
  id          Int        @id @default(1)
  activeEvent RushEvent?
  updatedAt   DateTime   @updatedAt
}

// One check-in per rushee per event. A rushee's identity is the normalized
// (nyuEmail, phoneNumber) pair, so re-submitting the same event is a no-op and
// their attendance across events can be grouped on that pair. Both fields are
// stored already-normalized (lowercased netid@nyu.edu; digits-only phone).
model EventAttendance {
  id              String    @id @default(cuid())
  event           RushEvent
  name            String
  nyuEmail        String
  phoneNumber     String
  instagramHandle String?
  createdAt       DateTime  @default(now())

  @@unique([event, nyuEmail, phoneNumber])
  @@index([nyuEmail, phoneNumber])
}

// Editable message templates for the automatic thank-you and the follow-up
// message. One row per kind; the app falls back to built-in defaults if a row
// is missing, so messaging works before an admin ever opens the editor.
model MessageTemplate {
  id           String      @id @default(cuid())
  kind         MessageKind @unique
  emailSubject String
  emailBody    String      // plain text; {{firstName}} / {{name}} are substituted
  smsBody      String      // plain text; same placeholders
  updatedAt    DateTime    @updatedAt
}

model RushApplication {
  id              String   @id @default(cuid())
  term            String
  email           String
  fullName        String
  nyuEmail        String
  phoneNumber     String
  year            Year
  school          School
  instagramHandle String?
  // Sent timestamps: the automatic thank-you, and the follow-up message the
  // rush team sends to a chosen set of rushees. Drive the "sent" status UI.
  thankYouSentAt  DateTime?
  messageSentAt   DateTime?
  createdAt       DateTime @default(now())

  // One submission per rushee per rush cycle; re-applying next term is fine.
  @@unique([nyuEmail, term])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  role            Role     @default(RANDO)
  // Null until the user clicks the verification link in their email.
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())

  sessions Session[]
  tokens   VerificationToken[]
}

// One row per active login. The raw session token lives only in the user's
// cookie; we store its SHA-256 hash as the id so a leaked database can't be
// used to impersonate anyone.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per pledge class ("Beta Zeta", "Alpha Tau", ...). Greek class order
// isn't alphabetical (Alpha, Beta, ... then Alpha Alpha, Alpha Beta, ... then
// Beta Alpha, ...), so `sortOrder` — assigned chronologically — drives the tab
// order on both the Active House and Alumni pages.
model PledgeClass {
  id        String    @id @default(cuid())
  name      String    @unique
  // Human-readable term the class crossed, e.g. "Fall 2023". Optional.
  term      String?
  sortOrder Int       @unique
  brothers  Brother[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A single brother — active or alumnus. Graduating an active brother is just a
// status flip (ACTIVE -> ALUMNI); nothing is copied or deleted, so his big/
// little links and every other field survive the transition intact.
model Brother {
  id             String        @id @default(cuid())
  // The crossing number shown as "#240" on cards. Nullable for the handful of
  // brothers who never received one (e.g. transfers). Unique when present —
  // Postgres allows multiple NULLs under a UNIQUE constraint.
  crossingNumber Int?          @unique
  firstName      String
  lastName       String?
  // Pledge name for actives, aka "nickname" for alumni — same field.
  pledgeName     String
  status         BrotherStatus @default(ALUMNI)

  major          String?
  // Expected / actual graduation year, e.g. 2027. Shown for actives.
  gradYear       Int?
  instagram      String?       // handle without the leading "@"

  // Resolved image src used directly by the roster gallery. Points at a
  // committed file under /images/... for seeded members, or at
  // /api/brothers/{id}/photo once a photo is uploaded through the admin panel.
  photoUrl       String?

  classId     String
  pledgeClass PledgeClass @relation(fields: [classId], references: [id])

  // Big/little modeled as a self-relation: a brother's littles are everyone
  // whose `bigId` points back at him, so the list can never drift out of sync.
  bigId  String?
  big    Brother?  @relation("BigLittle", fields: [bigId], references: [id])
  littles Brother[] @relation("BigLittle")
  // For the earliest brothers whose big predates this roster (or isn't in it):
  // a plain display string used when `bigId` is null.
  bigNameFallback String?

  photo     BrotherPhoto?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([classId])
  @@index([status])
  @@index([bigId])
}

// Uploaded photo bytes live in the database rather than on disk: the app
// container's filesystem is ephemeral (only the Postgres volume persists), so a
// file written under public/ would vanish on the next deploy. Kept in its own
// table so roster queries never haul image bytes around. Images are resized and
// re-encoded to webp on upload, so each row is small (~50-150 KB).
model BrotherPhoto {
  id        String   @id @default(cuid())
  brotherId String   @unique
  brother   Brother  @relation(fields: [brotherId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String   @default("image/webp")
  updatedAt DateTime @updatedAt
}

// Single-use tokens for email verification and password resets. Same idea as
// sessions: only the hash is stored; the raw token is emailed to the user.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}
