generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BRO
  RANDO
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Year {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
}

enum School {
  STERN
  STEINHARDT
  CAS
  GALLATIN
  TANDON
  TISCH
  OTHER
}

model RushApplication {
  id              String   @id @default(cuid())
  term            String
  email           String
  fullName        String
  nyuEmail        String
  phoneNumber     String
  year            Year
  school          School
  instagramHandle String?
  createdAt       DateTime @default(now())

  // One submission per rushee per rush cycle; re-applying next term is fine.
  @@unique([nyuEmail, term])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  role            Role     @default(RANDO)
  // Null until the user clicks the verification link in their email.
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())

  sessions Session[]
  tokens   VerificationToken[]
}

// One row per active login. The raw session token lives only in the user's
// cookie; we store its SHA-256 hash as the id so a leaked database can't be
// used to impersonate anyone.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Single-use tokens for email verification and password resets. Same idea as
// sessions: only the hash is stored; the raw token is emailed to the user.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}
